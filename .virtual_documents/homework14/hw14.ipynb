def plot_luminosity_class(df, label, color):
    mask = df['SpType'].str.contains(label, na=False)
    plt.scatter(df[mask]['B-V'], df[mask]['M_V'], s=5, label=label, c=color, alpha=0.5)

plt.figure(figsize=(8,10))
plt.grid()
plt.xlim(-0.5, 2.5)
plt.ylim(15, -10)
plt.xlabel('Color Index (B-V)')
plt.ylabel('Absolute Magnitude')
plt.title('H-R Diagram with Luminosity Classes')

plot_luminosity_class(df_clean, 'V', 'black')  # Main Sequence
plot_luminosity_class(df_clean, 'III', 'green')  # Giants
plot_luminosity_class(df_clean, 'I', 'red')  # Supergiants

plt.legend()
plt.show()






# Your code here
def plot_luminosity_class(df, label, color):
    mask = df['SpType'].str.contains(label, na=False)
    plt.scatter(df[mask]['B-V'], df[mask]['M_V'], s=5, label=label, c=color, alpha=0.5)

# With
plt.figure(figsize=(8,10))
plt.grid()
plt.xlim(-0.5, 2.5)
plt.ylim(15, -10)
plt.xlabel('Color Index (B-V)')
plt.ylabel('Absolute Magnitude')
plt.title('H-R Diagram with Selected Luminosity Classes')

# Plot
plot_luminosity_class(df_clean, 'VI', 'blue')   # Subdwarfs
plot_luminosity_class(df_clean, 'VII', 'cyan')  # White Dwarfs
plot_luminosity_class(df_clean, 'IV', 'orange') # Subgiants
plot_luminosity_class(df_clean, 'II', 'purple') # Bright Giants

plt.legend()
plt.show()


# Without
df_without_selected = df_clean[~df_clean['SpType'].str.contains('VI|VII|IV|II', na=False)]

plt.figure(figsize=(8,10))
plt.grid()
plt.xlim(-0.5, 2.5)
plt.ylim(15, -10)
plt.xlabel('Color Index (B-V)')
plt.ylabel('Absolute Magnitude')
plt.title('H-R Diagram (Without VI, VII, IV, II)')

# Plot only the remaining stars (Main Sequence, Giants, Supergiants)
plot_luminosity_class(df_without_selected, 'V', 'black')   # Main Sequence
plot_luminosity_class(df_without_selected, 'III', 'green') # Giants
plot_luminosity_class(df_without_selected, 'I', 'red')     # Supergiants

plt.legend()
plt.show()



